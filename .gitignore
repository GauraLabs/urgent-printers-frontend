# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
qa-pipeline/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# next-sitemap (generated on every build)
/public/sitemap*.xml
/public/robots.txt

# typescript
*.tsbuildinfo
next-env.d.ts

# Google OAuth client secret files
client_secret*.json

# Windows Zone.Identifier metadata files (WSL artifact)
*:Zone.Identifier

# QA pipeline (see ../pipeline/README.md): screenshots/traces/video/audio are build products.
# Plans, run logs, analyses, shot lists and rendered docs stay tracked — diffing those is how
# a flow change shows up, and a checked-in report degrading to a filename note when a
# gitignored screenshot isn't on disk is expected, not a bug.
qa-pipeline/artifacts/screenshots
qa-pipeline/artifacts/traces
qa-pipeline/artifacts/video
qa-pipeline/artifacts/narration/**/*.mp3
qa-pipeline/playwright/fixtures/oversized*
qa-pipeline/artifacts/docs/**/*.pdf
playwright-report
test-results
