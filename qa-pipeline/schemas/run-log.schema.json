{
  "title": "Run Log (Playwright capture output — Shot-List Director input)",
  "type": "object",
  "required": ["feature_name", "run_timestamp", "viewport", "steps"],
  "additionalProperties": false,
  "properties": {
    "feature_name": { "type": "string", "minLength": 1 },
    "plan_path": { "type": ["string", "null"] },
    "run_timestamp": { "type": "string", "minLength": 1 },
    "trace_path": { "type": ["string", "null"] },
    "lighthouse": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "initial_load": { "type": ["object", "null"] },
        "final_state": { "type": ["object", "null"] }
      }
    },
    "viewport": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "number", "minimum": 1 },
        "height": { "type": "number", "minimum": 1 }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_id", "action", "selector", "bounding_box", "timestamp_ms", "screenshot_path", "status"],
        "additionalProperties": false,
        "properties": {
          "step_id": { "type": "string", "pattern": "^[a-z]+-[0-9]{2}$" },
          "action": { "type": "string", "minLength": 1 },
          "selector": { "type": ["string", "null"] },
          "route": { "type": ["string", "null"] },
          "bounding_box": {
            "type": ["object", "null"],
            "required": ["x", "y", "width", "height"],
            "additionalProperties": false,
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "width": { "type": "number", "minimum": 0 },
              "height": { "type": "number", "minimum": 0 }
            }
          },
          "timestamp_ms": { "type": "number", "minimum": 0 },
          "screenshot_path": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["pass", "fail"] },
          "error": { "type": ["string", "null"] },
          "typed_text": {
            "type": ["string", "null"],
            "description": "Text entered during this step, recorded by capture.type(). The renderer replays it keystroke by keystroke over the previous screenshot, which is the only way a video built from stills can show text being typed."
          },
          "typed_masked": {
            "type": "boolean",
            "description": "True when the field's input type is password, so the renderer draws dots rather than the literal value."
          },
          "axe_violations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "impact", "description"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "impact": { "type": "string", "enum": ["minor", "moderate", "serious", "critical"] },
                "description": { "type": "string", "minLength": 1 },
                "nodes": { "type": "number", "minimum": 0 }
              }
            }
          },
          "console_errors": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
