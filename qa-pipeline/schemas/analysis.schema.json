{
  "title": "Analysis (Module 5 output — Documentation Generator + Release Notes input)",
  "type": "object",
  "required": [
    "feature_name",
    "pass_count",
    "fail_count",
    "failures",
    "accessibility_summary",
    "performance_summary",
    "ux_gaps",
    "recommendations"
  ],
  "additionalProperties": false,
  "properties": {
    "feature_name": { "type": "string", "minLength": 1 },
    "run_path": { "type": ["string", "null"] },
    "plan_path": { "type": ["string", "null"] },
    "pass_count": { "type": "number", "minimum": 0 },
    "fail_count": { "type": "number", "minimum": 0 },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step_id", "likely_root_cause", "confidence"],
        "additionalProperties": false,
        "properties": {
          "step_id": { "type": "string", "pattern": "^[a-z]+-[0-9]{2}$" },
          "likely_root_cause": { "type": "string", "minLength": 1 },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "verdict": {
            "type": "string",
            "enum": ["real_regression", "plan_expectation_wrong", "undetermined"],
            "description": "The master plan asks the Analyzer to distinguish these two explicitly; recording it as a field keeps the judgement machine-readable for Release Notes."
          }
        }
      }
    },
    "accessibility_summary": {
      "type": "object",
      "required": ["critical", "serious", "moderate", "coverage_caveat"],
      "additionalProperties": false,
      "properties": {
        "critical": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "serious": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "moderate": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "coverage_caveat": { "type": "string", "minLength": 1 }
      }
    },
    "performance_summary": {
      "type": "object",
      "required": ["initial_load", "final_state", "concerns"],
      "additionalProperties": false,
      "properties": {
        "initial_load": { "type": ["string", "null"] },
        "final_state": { "type": ["string", "null"] },
        "concerns": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "ux_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue", "related_edge_case"],
        "additionalProperties": false,
        "properties": {
          "issue": { "type": "string", "minLength": 1 },
          "related_edge_case": { "type": ["string", "null"] }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["priority", "action"],
        "additionalProperties": false,
        "properties": {
          "priority": { "type": "string", "enum": ["high", "medium", "low"] },
          "action": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
